{
	"schemaVersion": 1,
	"id": "shhh-brightness-toggle",
	"version": "${version}",
	"name": "Shhh Brightness Toggle",
	"description": "A lightweight client-side mod that toggles full brightness and lets you adjust your brightness level with dynamic color feedback.",
	"authors": [
		"RafayShhh"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/shhh-brightness-toggle",
		"sources": "https://github.com/RafayShhh/shhh-brightness-toggle",
		"issues": "https://github.com/RafayShhh/shhh-brightness-toggle/issues"
	},
	"license": "MIT",
	"icon": "assets/shhh-brightness-toggle/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.rafayshhh.brightness.client.ShhhBrightnessToggleClient"
		],
		"modmenu": [
			"com.rafayshhh.brightness.client.compat.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "shhh-brightness-toggle.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "=26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
